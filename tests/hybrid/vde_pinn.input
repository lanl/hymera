# VDE run from t = 0 on the PINN equilibrium: tests/hybrid/vde_seed.input with the
# changes below. Needs a hybrid with the predictor and deposit fixes and
# Hybrid/feedback_gain.
#   Equilibrium: the ITER PINN (tools/pinn_equilibrium), psi/g on the 100x2x200
#     grid with g sign -1 (B_phi < 0 as in inputs/mhd), material tags from
#     inputs/WallCoords.jl (tools/pinn_equilibrium/make_tags.py). ../../inputs is a
#     directory holding those mhd/ files and AxisSymmetricGeometry.dat. Relaxed for
#     MHD_Config/relax_steps = 10 with this deck's MHD parameters into X_pinn10.petscbin.
#   Hybrid: feedback_gain = 1 (/timeseries/feedback, the loop gain of the in-step
#     runaway-current correction of E).
#   Hybrid: p_BC_factor = 0.2 (gamma_BC - 1 = 0.2 E_c / max |E_par|, was 0.1): about 0.4 of
#     the critical energy, fewer slow electrons. gamma_min follows (2 (gamma_BC - 1)).
#     gamma_min_floor stays 1.0001: a 1.02 floor cut the secondary weight by 2.5%
#     in one step at no speed gain (results/scr_bench).
<parthenon/job>
problem_id = vde_pinn

<parthenon/mesh>
nx1 = 512
x1min = -2.0
x1max = 2.0
ix1_bc = periodic
ox1_bc = periodic
task_collection_timeout_in_seconds = 28000

nx2 = 256
x2min = -2.0
x2max = 2.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

# How many meshblocks to use in a premade default kernel.
# A value of <1 means use the whole mesh.
pack_size = -1

<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<MHD_Config>
input_folder=../../inputs/mhd
ic_binary_path=X_pinn10.petscbin
ic_binary_load=1

<Geometry>
input_file=../../inputs/AxisSymmetricGeometry.dat

<parthenon/time>
dt_force = 0.00027
tlim = 1.0
<Time>
nCD = 8
nPR = 1
dtLA_over_tauC = 1e-4

<ParticleSeed>
num_particles_per_block = 2048
current = 150.0
current_fraction = 1.0e-5
MaxParticles = 1048576
rng_seed = 1234
stratified = 1
bands = 200
pmin = 10.0
pmax = 20.0
ximin = 0.85
ximax = 0.95

<Simulation>
integrator=rk4
hRK=1e-7
verbosity=info
EnableLargeAngleCollisions=1
EnableSmallAngleCollisions=1
EnableComputeConservedQuantities=0
atol=1e-10
rtol=1e-9

<Plasma>
ZI = 3.0 # or 2.0
fI = 0.1

<Reference>
Te0 = 10.0
B0 = 5.3

<Collisions>
aI = 0.29197

<parthenon/output8>
file_type = rst
dt = 0.00027

<parthenon/output2>
file_type = hdf5
write_xdmf = false # Determines whether xdmf annotations are output
# nonexistent variables/swarms are ignored
swarms = particles  # Particle swarms
particles_variables = x, y, z, particle.p, particle.xi, particle.R, particle.phi, particle.Z, particle.weight, particle.will_scatter, particle.secondary_index, particle.status

dt = 0.00027
file_number_width = 6 # default: 5
use_final_label = true # default: true

<Hybrid>
midplane_profile = 1
update_gamma_min = 1
gamma_min_floor = 1.0001
p_BC_factor = 0.2
la_sampler = fast
jre_map = 1
feedback_gain = 1

<Output>
NR_plot = 100
NZ_plot = 200
