<parthenon/job>
problem_id = mhd

<parthenon/mesh>
nx1 = 512
x1min = -2.0
x1max = 2.0
ix1_bc = periodic
ox1_bc = periodic
task_collection_timeout_in_seconds = 28000

nx2 = 256
x2min = -2.0
x2max = 2.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

# How many meshblocks to use in a premade default kernel.
# A value of <1 means use the whole mesh.
pack_size = -1

<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<MHD_Config>
input_folder=../../inputs/mhd
ic_binary_path=X_4.petscbin
ic_binary_load=1

<Geometry>
input_file=../../inputs/AxisSymmetricGeometry.dat

<parthenon/time>
dt_force = 0.00108
tlim = 0.04320

<ParticleSeed>
num_particles_per_block = 0

<Plasma>
ZI = 3.0 # or 2.0
fI = 0.1

<Reference>
Te0 = 10.0
B0 = 5.3

<Collisions>
aI = 0.29197

<parthenon/output8>
file_type = rst
dt = 0.00108

<parthenon/output2>
file_type = hdf5
write_xdmf = false # Determines whether xdmf annotations are output
# nonexistent variables/swarms are ignored

dt = 0.00108
file_number_width = 6 # default: 5
use_final_label = true # default: true

