# Example MFEM executable: heat equation on the unit square, driven by Parthenon's
# EvolutionDriver. The Parthenon mesh below is a placeholder required by the driver;
# the physics lives on the MFEM mesh configured in <MFEM_Heat>.

<parthenon/job>
problem_id = mfem_heat

<parthenon/mesh>
nx1 = 16
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 16
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

# Need at least one meshblock per MPI rank, even though the blocks are unused.
<parthenon/meshblock>
nx1 = 4
nx2 = 4
nx3 = 1

<parthenon/time>
dt_force = 0.001
tlim = 0.05

<MFEM_Heat>
nx = 16
ny = 16
serial_refinements = 1
parallel_refinements = 0
order = 2
kappa = 1.0
solver_rtol = 1e-12
output_dir = mfem_heat   # ParaView collection, written on each Parthenon output

# MFEM ParaView dump (to output_dir) piggybacks on Parthenon mesh outputs through
# UserMeshWorkBeforeOutput, so it needs an hdf5 block; history outputs do not trigger it.
<parthenon/output0>
file_type = hdf5
dt = 0.01
