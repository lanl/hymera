# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
bin/*

# debug information files
*.dwo
build/*

# Run dirs
run/*

# Outputs
*hdf
*dat
*dat.info

# Cache
__pycache__
.cache

# Regression harness. The rules above exclude *dat and *hdf, which would
# otherwise swallow the committed fixtures and baselines, so re-include the
# harness tree explicitly. Scoped to tests/regression so it cannot accidentally
# re-include run output elsewhere.
!tests/regression/**

# Generated figures are reproducible from the committed fixtures, so they are
# not tracked. Same for bytecode: the re-include above outranks the global
# __pycache__ rule, so restate it here.
tests/regression/viz/out/
tests/regression/**/__pycache__/
